4s;transform:rotate(240deg) translate(146%)}.sonner-loading-bar:nth-child(10){animation-delay:-.3s;transform:rotate(270deg) translate(146%)}.sonner-loading-bar:nth-child(11){animation-delay:-.2s;transform:rotate(300deg) translate(146%)}.sonner-loading-bar:nth-child(12){animation-delay:-.1s;transform:rotate(330deg) translate(146%)}@keyframes sonner-fade-in{0%{opacity:0;transform:scale(.8)}100%{opacity:1;transform:scale(1)}}@keyframes sonner-fade-out{0%{opacity:1;transform:scale(1)}100%{opacity:0;transform:scale(.8)}}@keyframes sonner-spin{0%{opacity:1}100%{opacity:.15}}@media (prefers-reduced-motion){.sonner-loading-bar,[data-sonner-toast],[data-sonner-toast]>*{transition:none!important;animation:none!important}}.sonner-loader{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);transform-origin:center;transition:opacity .2s,transform .2s}.sonner-loader[data-visible=false]{opacity:0;transform:scale(.8) translate(-50%,-50%)}</style><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/638194.337402d0a4.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/449840.40420e781c.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/146419.d944dab66c.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/694521.e8a1d2e2af.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/946709.2700ada71a.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/149402.dde1d7a23a.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/750841.b4490b6237.css"><script async="" src="./fundo-luxo_files/api.js.download"></script><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/42020.dfb2e7da69.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/755742.02b0b4750d.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/520121.dc3ae59ae5.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/29154.d7313b0c44.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/617668.efea808fba.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/931744.098f7e1bf3.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/52079.b4199cca4b.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/214210.000f30bc53.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/952734.c28a1f0121.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/254963.509d3ce166.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/520289.a8bb59415e.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/349813.4df6b70f66.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/149484.3c5b491f67.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/197621.87585aecb4.css"><meta http-equiv="origin-trial" content="AnY33Lstn7fSTXvj63Z4glPcRXtUukuM9rLN87JGOugFyfum9ckNUU3NYHeRLcp6TELT5wbCZih5SlHfumMbJAkAAABmeyJvcmlnaW4iOiJodHRwczovL2NoYXRncHQuY29tOjQ0MyIsImZlYXR1cmUiOiJXZWJSdGNTY3RwU25hcCIsImV4cGlyeSI6MTc5NDg3MzYwMCwiaXNTdWJkb21haW4iOnRydWV9"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/620738.7ad2b1fead.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/41469.8333ccb199.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/678792.17c443d592.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/342464.8976f51c51.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/252139.247a3df04f.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/644924.778aa58302.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/425399.bc211f6f10.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/195729.a3a76ffc5d.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/991775.b1c7a2a2a2.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/108872.4292a89554.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/611280.117cc6e0d9.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/561151.db777e3226.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/602789.345ae3162f.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/805639.9f3766824a.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/163374.24d502530f.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/526560.33280a63e1.css"><link rel="stylesheet" type="text/css" href="./fundo-luxo_files/516588.13b17f3696.css"><link rel="stylesheet" type="text/css" href="https://chatgpt.com/cdn/assets/async/131734.db5bc5e909.css"></head><body style="--font-ui-size: 16px; --text-4xl: 36px; --text-3xl: 30px; --text-2xl: 24px; --text-xl: 20px; --text-lg: 18px; --text-base: 16px; --text-sm: 14px; --text-xs: 12px; --text-dynamic-isle-row: 14px; --text-heading-lg: 24px; --text-heading-app: 28px; --text-heading-md: 20px; --text-heading-sm: 18px;"><script nonce="">
(() => {
  const key = "oai-epic-native-launch";
  let launch = null;
  try { launch = JSON.parse(sessionStorage.getItem(key) || "null"); } catch {}
  function save() {
    try {
      if (launch) sessionStorage.setItem(key, JSON.stringify(launch));
      else sessionStorage.removeItem(key);
    } catch { launch = null; }
  }
  function capture() {
    const fragment = window.location.hash;
    if (!fragment) return;
    window.history.replaceState(window.history.state, "", "/epic/launch");
    const params = new URLSearchParams(fragment.slice(1));
    const snapshot = params.get("snapshot");
    const workspace = params.get("workspace_id");
    launch = Array.from(params).length === (workspace ? 2 : 1) && (!workspace || /^[A-Za-z0-9_-]{1,128}$/.test(workspace)) && snapshot &&
      /^[A-Za-z0-9_-]{80,16384}={0,2}$/.test(snapshot)
      ? { snapshot, workspace, id: crypto.randomUUID(), messageId: null, draftId: null } : null;
    save();
  }
  if (window.location.pathname === "/epic/launch") capture();
  function pending() {
    return launch && !launch.draftId && new URLSearchParams(window.location.search).get("epic_launch") === launch.id
      ? launch.snapshot : null;
  }
  window.__oaiEpicNativeLaunch = {
    get: () => launch?.snapshot ?? null,
    workspace: () => launch?.workspace ?? null,
    destination: () => launch ? "/?surface=work&epic_launch=" + launch.id : "/epic/launch",
    pending,
    ownsMessage: (messageId) => launch?.messageId === messageId,
    metadata: (messageId, draftId) => {
      if (!launch) return;
      if (draftId != null) {
        if (launch.draftId ? launch.draftId !== draftId : !pending()) return;
        launch.draftId = draftId;
      } else if (launch.messageId !== messageId) return;
      const changed = launch.messageId !== messageId;
      launch.messageId = messageId;
      save();
      if (changed) window.dispatchEvent(new Event("oai-epic-launch-changed"));
      return launch ? { epic_launch_snapshot: launch.snapshot } : undefined;
    },
    claimAttachmentNotification: (expected) => {
      if (!launch || launch.snapshot !== expected || launch.attachmentNotified) return false;
      launch.attachmentNotified = true;
      save();
      return true;
    },
    clear: (expected) => {
      if (launch?.snapshot === expected || launch?.messageId === expected) {
        launch = null;
        save();
        window.dispatchEvent(new Event("oai-epic-launch-changed"));
      }
    }
  };
  window.addEventListener("hashchange", () => {
    if (window.location.pathname !== "/epic/launch" || !window.location.hash) return;
    capture();
    window.dispatchEvent(new Event("oai-epic-launch-changed"));
  });
})();
