            </span><span class="text-codex-syntax-string">"aria-pressed"</span><span>,
            </span><span class="text-codex-syntax-variable">botao</span><span class="text-codex-syntax-keyword">.</span><span>classList</span><span class="text-codex-syntax-keyword">.</span><span>contains(</span><span class="text-codex-syntax-string">"ativo"</span><span>) </span><span class="text-codex-syntax-keyword">?</span><span> </span><span class="text-codex-syntax-string">"true"</span><span> </span><span class="text-codex-syntax-keyword">:</span><span> </span><span class="text-codex-syntax-string">"false"</span><span>
        );
    });

</span><span class="text-codex-syntax-variable">document</span><span class="text-codex-syntax-keyword">.</span><span>getElementById(</span><span class="text-codex-syntax-string">"visualizador"</span><span>)
    </span><span class="text-codex-syntax-keyword">.</span><span>addEventListener(</span><span class="text-codex-syntax-string">"click"</span><span>, </span><span class="text-codex-syntax-keyword">function</span><span>(</span><span class="text-codex-syntax-variable">evento</span><span>) {
        </span><span class="text-codex-syntax-keyword">if</span><span> (</span><span class="text-codex-syntax-variable">evento</span><span class="text-codex-syntax-keyword">.</span><span>target </span><span class="text-codex-syntax-keyword">===</span><span> </span><span class="text-codex-syntax-literal">this</span><span>) {
            </span><span class="text-codex-syntax-variable">fecharImagem</span><span>();
        }
    });

</span><span class="text-codex-syntax-variable">document</span><span class="text-codex-syntax-keyword">.</span><span>addEventListener(</span><span class="text-codex-syntax-string">"keydown"</span><span>, </span><span class="text-codex-syntax-keyword">function</span><span>(</span><span class="text-codex-syntax-variable">evento</span><span>) {
    </span><span class="text-codex-syntax-keyword">const</span><span> </span><span class="text-codex-syntax-variable">visualizador</span><span> </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">document</span><span class="text-codex-syntax-keyword">.</span><span>getElementById(</span><span class="text-codex-syntax-string">"visualizador"</span><span>);

    </span><span class="text-codex-syntax-keyword">if</span><span> (</span><span class="text-codex-syntax-keyword">!</span><span class="text-codex-syntax-variable">visualizador</span><span class="text-codex-syntax-keyword">.</span><span>classList</span><span class="text-codex-syntax-keyword">.</span><span>contains(</span><span class="text-codex-syntax-string">"aberto"</span><span>)) {
        </span><span class="text-codex-syntax-keyword">return</span><span>;
    }

    </span><span class="text-codex-syntax-keyword">if</span><span> (</span><span class="text-codex-syntax-variable">evento</span><span class="text-codex-syntax-keyword">.</span><span>key </span><span class="text-codex-syntax-keyword">===</span><span> </span><span class="text-codex-syntax-string">"Escape"</span><span>) {
        </span><span class="text-codex-syntax-variable">fecharImagem</span><span>();
    }

    </span><span class="text-codex-syntax-keyword">if</span><span> (</span><span class="text-codex-syntax-variable">evento</span><span class="text-codex-syntax-keyword">.</span><span>key </span><span class="text-codex-syntax-keyword">===</span><span> </span><span class="text-codex-syntax-string">"ArrowRight"</span><span>) {
        </span><span class="text-codex-syntax-variable">evento</span><span class="text-codex-syntax-keyword">.</span><span>preventDefault();
        </span><span class="text-codex-syntax-variable">navegarImagem</span><span>(</span><span class="text-codex-syntax-literal">1</span><span>);
    }

    </span><span class="text-codex-syntax-keyword">if</span><span> (</span><span class="text-codex-syntax-variable">evento</span><span class="text-codex-syntax-keyword">.</span><span>key </span><span class="text-codex-syntax-keyword">===</span><span> </span><span class="text-codex-syntax-string">"ArrowLeft"</span><span>) {
        </span><span class="text-codex-syntax-variable">evento</span><span class="text-codex-syntax-keyword">.</span><span>preventDefault();
        </span><span class="text-codex-syntax-variable">navegarImagem</span><span>(</span><span class="text-codex-syntax-keyword">-</span><span class="text-codex-syntax-literal">1</span><span>);
    }

    </span><span class="text-codex-syntax-keyword">if</span><span> (</span><span class="text-codex-syntax-variable">evento</span><span class="text-codex-syntax-keyword">.</span><span>key </span><span class="text-codex-syntax-keyword">===</span><span> </span><span class="text-codex-syntax-string">"Tab"</span><span>) {
        </span><span class="text-codex-syntax-keyword">const</span><span> </span><span class="text-codex-syntax-variable">botoes</span><span> </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">Array</span><span class="text-codex-syntax-keyword">.</span><span>from(
            </span><span class="text-codex-syntax-variable">visualizador</span><span class="text-codex-syntax-keyword">.</span><span>querySelectorAll(</span><span class="text-codex-syntax-string">"button"</span><span>)
        )</span><span class="text-codex-syntax-keyword">.</span><span>filter(</span><span class="text-codex-syntax-keyword">function</span><span>(</span><span class="text-codex-syntax-variable">botao</span><span>) {
            </span><span class="text-codex-syntax-keyword">return</span><span> </span><span class="text-codex-syntax-variable">botao</span><span class="text-codex-syntax-keyword">.</span><span>style</span><span class="text-codex-syntax-keyword">.</span><span>display </span><span class="text-codex-syntax-keyword">!==</span><span> </span><span class="text-codex-syntax-string">"none"</span><span>;
        });

        </span><span class="text-codex-syntax-keyword">const</span><span> </span><span class="text-codex-syntax-variable">primeiro</span><span> </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">botoes</span><span>[</span><span class="text-codex-syntax-literal">0</span><span>];
        </span><span class="text-codex-syntax-keyword">const</span><span> </span><span class="text-codex-syntax-variable">ultimo</span><span> </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">botoes</span><span>[</span><span class="text-codex-syntax-variable">botoes</span><span class="text-codex-syntax-keyword">.</span><span>length </span><span class="text-codex-syntax-keyword">-</span><span> </span><span class="text-codex-syntax-literal">1</span><span>];

        </span><span class="text-codex-syntax-keyword">if</span><span> (
            </span><span class="text-codex-syntax-variable">evento</span><span class="text-codex-syntax-keyword">.</span><span>shiftKey
            </span><span class="text-codex-syntax-keyword">&amp;&amp;</span><span> </span><span class="text-codex-syntax-variable">document</span><span class="text-codex-syntax-keyword">.</span><span>activeElement </span><span class="text-codex-syntax-keyword">===</span><span> </span><span class="text-codex-syntax-variable">primeiro</span><span>
        ) {
            </span><span class="text-codex-syntax-variable">evento</span><span class="text-codex-syntax-keyword">.</span><span>preventDefault();
            </span><span class="text-codex-syntax-variable">ultimo</span><span class="text-codex-syntax-keyword">.</span><span>focus();

        } </span><span class="text-codex-syntax-keyword">else</span><span> </span><span class="text-codex-syntax-keyword">if</span><span> (
            </span><span class="text-codex-syntax-keyword">!</span><span class="text-codex-syntax-variable">evento</span><span class="text-codex-syntax-keyword">.</span><span>shiftKey
            </span><span class="text-codex-syntax-keyword">&amp;&amp;</span><span> </span><span class="text-codex-syntax-variable">document</span><span class="text-codex-syntax-keyword">.</span><span>activeElement </span><span class="text-codex-syntax-keyword">===</span><span> </span><span class="text-codex-syntax-variable">ultimo</span><span>
        ) {
            </span><span class="text-codex-syntax-variable">evento</span><span class="text-codex-syntax-keyword">.</span><span>preventDefault();
            </span><span class="text-codex-syntax-variable">primeiro</span><span class="text-codex-syntax-keyword">.</span><span>focus();
        }
    }
});
</span><span class="text-codex-syntax-name">&lt;/script&gt;</span><span>

