    </span><span class="text-codex-syntax-keyword">const</span><span> </span><span class="text-codex-syntax-variable">visualizador</span><span> </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">document</span><span class="text-codex-syntax-keyword">.</span><span>getElementById(</span><span class="text-codex-syntax-string">"visualizador"</span><span>);

    </span><span class="text-codex-syntax-variable">visualizador</span><span class="text-codex-syntax-keyword">.</span><span>classList</span><span class="text-codex-syntax-keyword">.</span><span>remove(</span><span class="text-codex-syntax-string">"aberto"</span><span>);
    </span><span class="text-codex-syntax-variable">visualizador</span><span class="text-codex-syntax-keyword">.</span><span>setAttribute(</span><span class="text-codex-syntax-string">"aria-hidden"</span><span>, </span><span class="text-codex-syntax-string">"true"</span><span>);

    </span><span class="text-codex-syntax-variable">document</span><span class="text-codex-syntax-keyword">.</span><span>getElementById(</span><span class="text-codex-syntax-string">"imagem-ampliada"</span><span>)
        </span><span class="text-codex-syntax-keyword">.</span><span>removeAttribute(</span><span class="text-codex-syntax-string">"src"</span><span>);

    </span><span class="text-codex-syntax-variable">document</span><span class="text-codex-syntax-keyword">.</span><span>body</span><span class="text-codex-syntax-keyword">.</span><span>style</span><span class="text-codex-syntax-keyword">.</span><span>overflow </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">overflowAnterior</span><span>;

    </span><span class="text-codex-syntax-keyword">if</span><span> (
        </span><span class="text-codex-syntax-variable">elementoAnterior</span><span>
        </span><span class="text-codex-syntax-keyword">&amp;&amp;</span><span> </span><span class="text-codex-syntax-keyword">typeof</span><span> </span><span class="text-codex-syntax-variable">elementoAnterior</span><span class="text-codex-syntax-keyword">.</span><span>focus </span><span class="text-codex-syntax-keyword">===</span><span> </span><span class="text-codex-syntax-string">"function"</span><span>
    ) {
        </span><span class="text-codex-syntax-variable">elementoAnterior</span><span class="text-codex-syntax-keyword">.</span><span>focus();
