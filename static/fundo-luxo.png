-message flex w-full flex-col gap-1 items-end"><div data-user-message-bubble="true" class="bg-user-message text-user-message min-w-0 max-w-(--user-chat-width) overflow-hidden break-words px-(--thread-content-margin) [&amp;_.contain-inline-size]:[contain:initial] bubble-vBnidZ py-2.5 rounded-2xl relative text-start"><div class="flex flex-col items-end gap-1"><div class="relative w-full min-w-0 text-size-chat leading-relaxed"><div class="overflow-hidden" data-search-result-target="" style="max-height: 19lh;"><div><div class="text-size-chat whitespace-pre-wrap" dir="auto">from flask import Flask
from loja import loja_bp
from servicos import servicos_bp
from valores import valores_bp  # 🔥 NOVA IMPORTAÇÃO

app = Flask(__name__)
app.secret_key = "segredo123"

# 🔥 BLUEPRINTS
app.register_blueprint(loja_bp)
app.register_blueprint(servicos_bp)
app.register_blueprint(valores_bp)  # 🔥 REGISTRO DA PÁGINA DE VALORES

# 🔥 ROTA PRA MANTER O SITE ATIVO
@app.route("/ping")
def ping():
    return "ok"

if __name__ == "__main__":
    app.run(debug=True)</div></div></div><span aria-hidden="true" class="block">…</span></div><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex border gap-1 rounded-none text-user-message not-disabled:not-aria-disabled:hover:bg-transparent data-[state=open]:bg-transparent border-transparent border-0 p-0 mt-1.5 self-start text-size-chat" aria-expanded="false" data-thread-find-skip="true" data-markdown-copy="exclude"><span>Mostrar mais</span><svg width="20" height="21" viewBox="0 0 20 21" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon-2xs"><path d="M15.2793 7.71101C15.539 7.45131 15.961 7.45131 16.2207 7.71101C16.4804 7.97071 16.4804 8.39272 16.2207 8.65242L10.4707 14.4024C10.211 14.6621 9.78902 14.6621 9.52932 14.4024L3.77932 8.65242L3.69436 8.54792C3.52385 8.28979 3.55205 7.93828 3.77932 7.71101C4.00659 7.48374 4.3581 7.45554 4.61623 7.62605L4.72073 7.71101L10 12.9903L15.2793 7.71101Z" fill="currentColor" stroke="currentColor" stroke-width="0.6"></path></svg></button></div></div><div class="flex flex-row-reverse items-center gap-1"><div class="isolate me-1 ms-1 flex items-center gap-2 opacity-0 group-focus-within/user-message:opacity-100 group-hover/user-message:opacity-100 [@media(hover:none)]:opacity-100"><div class="flex turn-action-controls items-center gap-0.5 browser:gap-0"><span data-state="closed" class="contents"><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex border gap-1 rounded-full electron:rounded-md text-tertiary not-disabled:not-aria-disabled:hover:bg-pr