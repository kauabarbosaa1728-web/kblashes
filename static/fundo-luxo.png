        </span><span class="text-codex-syntax-attribute">href</span><span class="text-codex-syntax-keyword">=</span><span class="text-codex-syntax-string">"/static/css/style.css"</span><span>
    </span><span class="text-codex-syntax-name">&gt;</span><span>

    </span><span class="text-codex-syntax-name">&lt;style&gt;</span><span>
        .</span><span class="text-codex-syntax-literal">portfolio-hero</span><span>,
        .</span><span class="text-codex-syntax-literal">portfolio-container</span><span>,
        .</span><span class="text-codex-syntax-literal">visualizador</span><span> {
            box-sizing: </span><span class="text-codex-syntax-literal">border-box</span><span>;
        }

        .</span><span class="text-codex-syntax-literal">portfolio-hero</span><span> </span><span class="text-codex-syntax-keyword">*</span><span>,
        .</span><span class="text-codex-syntax-literal">portfolio-container</span><span> </span><span class="text-codex-syntax-keyword">*</span><span>,
        .</span><span class="text-codex-syntax-literal">visualizador</span><span> </span><span class="text-codex-syntax-keyword">*</span><span> {
            box-sizing: </span><span class="text-codex-syntax-literal">border-box</span><span>;
        }

        .</span><span class="text-codex-syntax-literal">portfolio-hero</span><span> {
            padding: </span><span class="text-codex-syntax-literal">85</span><span class="text-codex-syntax-keyword">px</span><span> </span><span class="text-codex-syntax-literal">22</span><span class="text-codex-syntax-keyword">px</span><span> </span><span class="text-codex-syntax-literal">65</span><span class="text-codex-syntax-keyword">px</span><span>;
            text-align: </span><span class="text-codex-syntax-literal">center</span><span>;
            background:
                </span><span class="text-codex-syntax-keyword">radial-gradient</span><span>(
                    </span><span class="text-codex-syntax-literal">ellipse</span><span> </span><span class="text-codex-syntax-literal">at</span><span> </span><span class="text-codex-syntax-literal">50</span><span class="text-codex-syntax-keyword">%</span><span> </span><span class="text-codex-syntax-literal">0</span><span class="text-codex-syntax-keyword">%</span><span>,
                    </span><span class="text-codex-syntax-keyword">rgba</span><span>(</span><span class="text-codex-syntax-literal">40</span><span>, </span><span class="text-codex-syntax-literal">113</span><span>, </span><span class="text-codex-syntax-literal">190</span><span>, </span><span class="text-codex-syntax-literal">.16</span><span>),
                    </span><span class="text-codex-syntax-literal">transparent</span><span> </span><span class="text-codex-syntax-literal">60</span><span class="text-codex-syntax-keyword">%</span><span>
                ),
                #080c12;
            border-bottom: </span><span class="text-codex-syntax-literal">1</span><span class="text-codex-syntax-keyword">px</span><span> </span><span class="text-codex-syntax-literal">solid</span><span> #1d2938;
        }

        .</span><span class="text-codex-syntax-literal">portfolio-etiqueta</span><span> {
            display: </span><span class="text-codex-syntax-literal">inline-block</span><span>;
            margin-bottom: </span><span class="text-codex-syntax-literal">17</span><span class="text-codex-syntax-keyword">px</span><span>;
            padding: </span><span class="text-codex-syntax-literal">7</span><span class="text-codex-syntax-keyword">px</span><span> </span><span class="text-codex-syntax-literal">13</span><span class="text-codex-syntax-keyword">px</span><span>;
            background: #122235;
