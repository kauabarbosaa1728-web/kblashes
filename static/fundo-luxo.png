            border-radius: </span><span class="text-codex-syntax-literal">30</span><span class="text-codex-syntax-keyword">px</span><span>;
            color: #8ac9ff;
            font-size: </span><span class="text-codex-syntax-literal">11</span><span class="text-codex-syntax-keyword">px</span><span>;
            font-weight: </span><span class="text-codex-syntax-literal">700</span><span>;
            letter-spacing: </span><span class="text-codex-syntax-literal">1.4</span><span class="text-codex-syntax-keyword">px</span><span>;
        }

        .</span><span class="text-codex-syntax-literal">portfolio-hero</span><span> </span><span class="text-codex-syntax-name">h2</span><span> {
            max-width: </span><span class="text-codex-syntax-literal">850</span><span class="text-codex-syntax-keyword">px</span><span>;
            margin: </span><span class="text-codex-syntax-literal">0</span><span> </span><span class="text-codex-syntax-literal">auto</span><span> </span><span class="text-codex-syntax-literal">22</span><span class="text-codex-syntax-keyword">px</span><span>;
            color: #f3f7fc;
            font-size: </span><span class="text-codex-syntax-keyword">clamp</span><span>(</span><span class="text-codex-syntax-literal">36</span><span class="text-codex-syntax-keyword">px</span><span>, </span><span class="text-codex-syntax-literal">5</span><span class="text-codex-syntax-keyword">vw</span><span>, </span><span class="text-codex-syntax-literal">58</span><span class="text-codex-syntax-keyword">px</span><span>);
