</span><span class="text-codex-syntax-name">&lt;html</span><span> </span><span class="text-codex-syntax-attribute">lang</span><span class="text-codex-syntax-keyword">=</span><span class="text-codex-syntax-string">"pt-BR"</span><span class="text-codex-syntax-name">&gt;</span><span>

</span><span class="text-codex-syntax-name">&lt;head&gt;</span><span>
    </span><span class="text-codex-syntax-name">&lt;meta</span><span> </span><span class="text-codex-syntax-attribute">charset</span><span class="text-codex-syntax-keyword">=</span><span class="text-codex-syntax-string">"UTF-8"</span><span class="text-codex-syntax-name">&gt;</span><span>

