            font-size: </span><span class="text-codex-syntax-literal">30</span><span class="text-codex-syntax-keyword">px</span><span>;
        }

        .</span><span class="text-codex-syntax-literal">portfolio-intro</span><span> </span><span class="text-codex-syntax-name">p</span><span>,
        .</span><span class="text-codex-syntax-literal">portfolio-servicos</span><span> </span><span class="text-codex-syntax-keyword">&gt;</span><span> </span><span class="text-codex-syntax-name">p</span><span> {
            margin: </span><span class="text-codex-syntax-literal">0</span><span>;
            color: #a5b3c5;
            line-height: </span><span class="text-codex-syntax-literal">1.8</span><span>;
        }

        .</span><span class="text-codex-syntax-literal">portfolio-grid</span><span> {
            display: </span><span class="text-codex-syntax-literal">grid</span><span>;
            grid-template-columns: </span><span class="text-codex-syntax-keyword">repeat</span><span>(</span><span class="text-codex-syntax-literal">2</span><span>, </span><span class="text-codex-syntax-keyword">minmax</span><span>(</span><span class="text-codex-syntax-literal">0</span><span>, </span><span class="text-codex-syntax-literal">1</span><span class="text-codex-syntax-keyword">fr</span><span>));
            align-items: </span><span class="text-codex-syntax-literal">stretch</span><span>;
            gap: </span><span class="text-codex-syntax-literal">24</span><span class="text-codex-syntax-keyword">px</span><span>;
        }

        .</span><span class="text-codex-syntax-literal">projeto-card</span><span> {
            display: </span><span class="text-codex-syntax-literal">flex</span><span>;
