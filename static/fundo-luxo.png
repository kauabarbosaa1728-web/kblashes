},{\"_1261\":1298,\"_1270\":1299,\"_1300\":1301},\"Out\",\"R$ 12,8 mil\",\"despesas\",\"R$ 4,4 mil\",\"Set\",\"R$ 11 mil\",\"R$ 6,2 mil\",\"Ago\",\"R$ 8,8 mil\",\"R$ 5,7 mil\",\"Jul\",\"R$ 9,6 mil\",\"R$ 4,8 mil\",\"Jun\",\"R$ 8,2 mil\",\"R$ 5,1 mil\",\"Mai\",\"R$ 4,2 mil\",{\"_1261\":1314,\"_1270\":1287,\"_1300\":1332},{\"_1261\":1311,\"_1270\":1330,\"_1300\":1331},{\"_1261\":1308,\"_1270\":1328,\"_1300\":1329},{\"_1261\":1305,\"_1270\":1326,\"_1300\":1327},{\"_1261\":1302,\"_1270\":1324,\"_1300\":1325},{\"_1261\":1298,\"_1270\":1322,\"_1300\":1323},12800,4350,11000,6200,8800,5700,9600,4800,8200,5100,4200,{\"_1335\":1270,\"_1283\":1340,\"_1337\":1338,\"_1339\":1270},{\"_1335\":1300,\"_1283\":1336,\"_1337\":1338,\"_1339\":1270},\"dataKey\",\"Despesas\",\"valuePrefix\",\"R$ \",\"axisId\",\"Receitas\",\"footer\",\"Dados fictícios para demonstração\",[450],[1345],\"BORA, MEU MANO! 🔥💙🚀\\n\\nVamos criar mais um sistema para o portfólio da **KBSistemas**! Dessa vez, um **Sistema de Planejamento Financeiro**, com visual premium, gráficos e banco de dados.\\n\\nA ideia é desenvolver um sistema que uma pessoa ou empresa possa utilizar para controlar dinheiro, planejar gastos e acompanhar suas metas.\\n\\n## \u003cicon name=\\\"wallet\\\" color=\\\"info\\\" inline/\u003e KBSistemas Finance — Gestão Financeira Inteligente\\n\\n\u003cbox background=\\\"#080e18\\\" theme=\\\"dark\\\" radius=\\\"2xl\\\" padding={3} gap={3}\u003e\\n  \u003crow align=\\\"center\\\" justify=\\\"between\\\"\u003e\\n    \u003cbox gap={1}\u003e\\n      \u003ctext color=\\\"secondary\\\" size=\\\"2xs\\\" weight=\\\"medium\\\"\u003eKB FINANCE\u003c/text\u003e\\n      \u003ctitle size=\\\"lg\\\" color=\\\"default\\\"\u003eVisão financeira\u003c/title\u003e\\n      \u003ctext color=\\\"tertiary\\\" size=\\\"2xs\\\"\u003ePrévia ilustrativa do sistema\u003c/text\u003e\\n    \u003c/box\u003e\\n    \u003cbox background=\\\"#14283f\\\" radius=\\\"lg\\\" padding={2}\u003e\\n      \u003cicon name=\\\"wallet\\\" color=\\\"#59b5ff\\\" size=\\\"lg\\\"/\u003e\\n    \u003c/box\u003e\\n  \u003c/row\u003e\\n  \u003cgrid columns={2} gap={2}\u003e\\n    {#each [{label:\\\"Saldo disponível\\\",value:\\\"R$ 8.450,00\\\",color:\\\"#70baff\\\",icon:\\\"wallet\\\"},{label:\\\"Receitas do mês\\\",value:\\\"R$ 12.800,00\\\",color:\\\"#5bdaa5\\\",icon:\\\"trending-up\\\"},{label:\\\"Despesas do mês\\\",value:\\\"R$ 4.350,00\\\",color:\\\"#ff9292\\\",icon:\\\"trending-down\\\"},{label:\\\"Meta de economia\\\",value:\\\"68%\\\",color:\\\"#c4a2ff\\\",icon:\\\"target\\\"}] as item}\\n      \u003cbox background=\\\"#121e2e\\\" border={{size:1,color:\\\"#263d56\\\"}} radius=\\\"lg\\\" padding={3} gap={2}\u003e\\n        \u003ctext color=\\\"secondary\\\" size=\\\"2xs\\\"\u003e{item.label}\u003c/text\u003e\\n        \u003ctitle size=\\\"md\\\" color={item.color} tabularNums\u003e{item.value}\u003c/title\u003e\\n      \u003c/box\u003e\\n    {/each}\\n  \u003c/grid\u003e\\n  \u003cbox background=\\\"#121e2e\\\" radius=\\\"lg\\\" padding={3} gap={2}\u003e\\n    **Receitas x Despesas**\\n    \u003cChart content={{\\\"chartType\\\":\\\"bar\\\",\\\"meta\\\":{\\\"footer\\\":\\\"Dados fictícios para demonstração\\\"},\\\"xKey\\\":\\\"mes\\\",\\\"series\\\":[{\\\"dataKey\\\":\\\"receitas\\\",\\\"label\\\":\\\"Receitas\\\",\\\"valuePrefix\\\":\\\"R$ \\\"},{\\\"dataKey\\\":\\\"despesas\\\",\\\"label\\\":\\\"Despesas\\\",\\\"valuePrefix\\\":\\\"R$ \\\"}],\\\"data\\\":[{\\\"mes\\\":\\\"Mai\\\",\\\"receitas\\\":7000,\\\"despesas\\\":4200},{\\\"mes\\\":\\\"Jun\\\",\\\"receitas\\\":8200,\\\"despesas\\\":5100},{\\\"mes\\\":\\\"Jul\\\",\\\"receitas\\\":9600,\\\"despesas\\\":4800},{\\\"mes\\\":\\\"Ago\\\",\\\"receitas\\\":8800,\\\"despesas\\\":5700},{\\\"mes\\\":\\\"Set\\\",\\\"receitas\\\":11000,\\\"despesas\\\":6200},{\\\"mes\\\":\\\"Out\\\",\\\"receitas\\\":12800,\\\"despesas\\\":4350}]}}/\u003e\\n  \u003c/box\u003e\\n\u003c/box\u003e\\n\\n## Funcionalidades que vamos desenvolver\\n\\n- \u003cicon name=\\\"layout-dashboard\\\" color=\\\"info\\\" inline/\u003e **Dashboard:** saldo, receitas, despesas e gráficos.\\n- \u003cicon name=\\\"plus-circle\\\" color=\\\"info\\\" inline/\u003e **Lançamentos:** cadastrar entradas e saídas de dinheiro.\\n- \u003cicon name=\\\"calendar-days\\\" color=\\\"info\\\" inline/\u003e **Planejamento mensal:** organizar contas e despesas futuras.\\n- \u003cicon name=\\\"target\\\" color=\\\"info\\\" inline/\u003e **Metas financeiras:** acompanhar quanto falta para economizar.\\n- \u003cicon name=\\\"chart-no-axes-combined\\\" color=\\\"info\\\" inline/\u003e **Relatórios:** acompanhar gastos por categoria e mês.\\n- \u003cicon name=\\\"lock-keyhole\\\" color=\\\"info\\\" inline/\u003e **Login:** cada usuário acessa seus próprios dados.\\n\\nVamos usar **Python + Flask + PostgreSQL**, com HTML, CSS e JavaScript, e depois publicar no Render, como nos outros projetos.\\n\\n## Só preciso definir uma coisa antes de começarmos:\\n\\n{@body const [tipo,setTipo] = DIL.useState(\\\"pessoal\\\")}\\n\u003cbox border radius=\\\"xl\\\" padding={3} gap={3}\u003e\\n  \u003cradio-group direction=\\\"col\\\" value={tipo} onChange={setTipo}\u003e\\n    \u003cradio value=\\\"pessoal\\\"\u003e**Finanças pessoais** — salários, contas, dívidas, economias e metas.\u003c/radio\u003e\\n    \u003cradio value=\\\"empresarial\\\"\u003e**Finanças empresariais** — faturamento, custos, lucro e fluxo de caixa.\u003c/radio\u003e\\n    \u003cradio value=\\\"ambos\\\"\u003e**Os dois** — o usuário escolhe entre pessoal e empresarial.\u003c/radio\u003e\\n  \u003c/radio-group\u003e\\n  \u003cbutton block onClick={()=\u003eGenUI.issueNewTurn(\\\"Vamos desenvolver o KBSistemas Finance para \\\"+(tipo===\\\"pessoal\\\"?\\\"finanças pessoais\\\":tipo===\\\"empresarial\\\"?\\\"finanças empresariais\\\":\\\"finanças pessoais e empresariais\\\")+\\\". Comece pela estrutura do projeto e o código completo, passo a passo.\\\")}\u003eVamos criar o sistema \u003cicon name=\\\"arrow-right\\\" inline/\u003e\u003c/button\u003e\\n\u003c/box\u003e\",{},{\"_456\":469,\"_458\":-5,\"_383\":1361},1791991734.379,1791991769.824632,{\"_451\":452,\"_453\":1359},{\"_406\":1186,\"_466\":-5,\"_410\":1187,\"_412\":1187,\"_1183\":1184,\"_1352\":1353,\"_1354\":1170,\"_414\":50,\"_1355\":17},\"paragen_variants_info\",{\"_446\":1356,\"_1356\":915,\"_1357\":1358,\"_1183\":1184,\"_323\":285},\"paragen_variant_choice\",\"has_versions\",\"num_variants_in_stream\",\"display_treatment\",\"skippable\",[1360],\"vamos fazer um sistema de planejamento economico?\",{}]\n");</script><!--$--><script nonce="">window.__reactRouterContext.streamController.close();</script><!--/$--><!--/$--><!--/$--><!--/$--><!--/$--><script nonce="" id="_R_">requestAnimationFrame(function(){$RT=performance.now()});</script><script nonce="">$RB=[];$RV=function(a){$RT=performance.now();for(var b=0;b<a.length;b+=2){var c=a[b],e=a[b+1];null!==e.parentNode&&e.parentNode.removeChild(e);var f=c.parentNode;if(f){var g=c.previousSibling,h=0;do{if(c&&8===c.nodeType){var d=c.data;if("/$"===d||"/&"===d)if(0===h)break;else h--;else"$"!==d&&"$?"!==d&&"$~"!==d&&"$!"!==d&&"&"!==d||h++}d=c.nextSibling;f.removeChild(c);c=d}while(c);for(;e.firstChild;)f.insertBefore(e.firstChild,c);g.data="$";g._reactRetry&&requestAnimationFrame(g._reactRetry)}}a.length=0};
