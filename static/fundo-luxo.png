                        rel=\\\"noopener noreferrer\\\"\u003e\\n[L965]                         Ver projeto ↗\\n                    \u003c/a\u003e\\n\\n[L968]                     \u003ca class=\\\"btn-projeto\\\" href=\\\"/orcamento\\\"\u003e\\n[L969]                         Criar site parecido →\\n                    \u003c/a\u003e\\n\\n[L972]                 \u003c/div\u003e\\n\\n[L974]             \u003c/div\u003e\\n\\n[L976]         \u003c/article\u003e\\n\\n[L978]     \u003c/div\u003e\\n\\n[L980]     \u003c!-- =====================================\\n[L981]          OUTROS SERVIÇOS\\n[L982]          ===================================== --\u003e\\n\\n[L984]     \u003csection class=\\\"portfolio-servicos\\\"\u003e\\n\\n[L986]         \u003ch2\u003eOutras soluções da KBSistemas\u003c/h2\u003e\\n\\n        \u003cp\u003e\\n[L989]             Além dos projetos apresentados, desenvolvemos\\n[L990]             soluções personalizadas para diferentes\\n[L991]             empresas e empreendedores.\\n        \u003c/p\u003e\\n\\n[L994]         \u003cdiv class=\\\"servicos-extra\\\"\u003e\\n\\n[L996]             \u003carticle class=\\\"servico-extra\\\"\u003e\\n[L997]                 \u003ch3\u003e🌐 Sites Profissionais\u003c/h3\u003e\\n                \u003cp\u003e\\n[L999]                     Sites institucionais, landing pages\\n[L1000]                     e páginas comerciais para empresas\\n[L1001]                     e profissionais autônomos.\\n                \u003c/p\u003e\\n[L1003]             \u003c/article\u003e\\n\\n[L1005]             \u003carticle class=\\\"servico-extra\\\"\u003e\\n[L1006]                 \u003ch3\u003e🛍️ Catálogos Digitais\u003c/h3\u003e\\n                \u003cp\u003e\\n[L1008]                     Catálogos personalizados para\\n[L1009]                     apresentar produtos, serviços,\\n[L1010]                     preços e contatos de forma organizada.\\n                \u003c/p\u003e\\n[L1012]             \u003c/article\u003e\\n\\n[L1014]             \u003carticle class=\\\"servico-extra\\\"\u003e\\n[L1015]                 \u003ch3\u003e🛒 Lojas Virtuais\u003c/h3\u003e\\n                \u003cp\u003e\\n[L1017]                     Desenvolvimento de lojas e\\n[L1018]                     vitrines digitais conforme\\n[L1019]                     as necessidades de cada negócio.\\n                \u003c/p\u003e\\n[L1021]             \u003c/article\u003e\\n\\n[L1023]         \u003c/div\u003e\\n\\n[L1025]         \u003cdiv style=\\\"margin-top:30px;\\\"\u003e\\n[L1026]             \u003ca href=\\\"/servicos\\\" class=\\\"botao\\\"\u003e\\n[L1027]                 Conhecer todos os serviços →\\n            \u003c/a\u003e\\n[L1029]         \u003c/div\u003e\\n\\n[L1031]     \u003c/section\u003e\\n\\n[L1033] \u003c/section\u003e\\n\\n[L1035] \u003c!-- DIFERENCIAIS --\u003e\\n\\n[L1037] \u003csection class=\\\"destaque\\\"\u003e\\n\\n[L1039]     \u003ch1\u003ePor que escolher a KBSistemas?\u003c/h1\u003e\\n\\n    \u003cp\u003e\\n[L1042]         Desenvolvemos soluções digitais com foco\\n[L1043]         em organização, praticidade e nas\\n[L1044]         necessidades de cada projeto.\\n    \u003c/p\u003e\\n\\n[L1047]     \u003cdiv class=\\\"frases\\\"\u003e\\n[L1048]         \u003ch2\u003e🚀 Sob medida\u003c/h2\u003e\\n[L1049]         \u003ch2\u003e⚡ Tecnologia moderna\u003c/h2\u003e\\n[L1050]         \u003ch2\u003e🔒 Controle de acesso\u003c/h2\u003e\\n[L1051]         \u003ch2\u003e📱 Design responsivo\u003c/h2\u003e\\n[L1052]     \u003c/div\u003e\\n\\n[L1054] \u003c/section\u003e\\n\\n[L1056] \u003c!-- CONTATO --\u003e\\n\\n[L1058] \u003csection class=\\\"contato-home\\\"\u003e\\n\\n[L1060]     \u003ch1\u003eGostou dos nossos projetos?\u003c/h1\u003e\\n\\n    \u003cp\u003e\\n[L1063]         Conte sua ideia e solicite um orçamento\\n[L1064]         para desenvolver uma solução personalizada.\\n    \u003c/p\u003e\\n\\n[L1067]     \u003ca href=\\\"/orcamento\\\" class=\\\"botao\\\"\u003e\\n[L1068]         Solicitar orçamento →\\n    \u003c/a\u003e\\n\\n[L1071] \u003c/section\u003e\\n\\n[L1073] \u003c/main\u003e\\n\\n[L1075] \u003c!-- WHATSAPP --\u003e\\n\\n\u003ca\\n[L1078]     href=\\\"https://wa.me/5511911524799?text=Ol%C3%A1%2C%20gostaria%20de%20solicitar%20um%20or%C3%A7amento\\\"\\n[L1079]     class=\\\"whatsapp\\\"\\n[L1080]     target=\\\"_blank\\\"\\n[L1081]     rel=\\\"noopener noreferrer\\\"\\n[L1082]     aria-label=\\\"Entrar em contato pelo WhatsApp\\\"\\n\u003e\\n    ☎\\n\u003c/a\u003e\\n\\n[L1087] \u003cfooter\u003e\\n    \u003cp\u003e\\n[L1089]         © 2026 KBSistemas — Desenvolvimento de\\n[L1090]         Sistemas, Sites e Aplicações Web.\\n    \u003c/p\u003e\\n[L1092] \u003c/footer\u003e\\n\\n[L1094] \u003c!-- =====================================\\n[L1095]      VISUALIZADOR DE IMAGENS\\n[L1096]      ===================================== --\u003e\\n\\n\u003cdiv\\n[L1099]     class=\\\"visualizador\\\"\\n[L1100]     id=\\\"visualizador\\\"\\n[L1101]     role=\\\"dialog\\\"\\n[L1102]     aria-modal=\\\"true\\\"\\n[L1103]     aria-label=\\\"Visualização ampliada de imagens\\\"\\n[L1104]     aria-hidden=\\\"true\\\"\\n[L1105]     tabindex=\\\"-1\\\"\\n\u003e\\n\\n[L1108]     \u003cbutton\\n[L1109]         class=\\\"fechar-visualizador\\\"\\n[L1110]         type=\\\"button\\\"\\n[L1111]         onclick=\\\"fecharImagem()\\\"\\n[L1112]         aria-label=\\\"Fechar imagem\\\"\\n    \u003e\\n        ×\\n[L1115]     \u003c/button\u003e\\n\\n[L1117]     \u003cbutton\\n[L1118]         class=\\\"navegar-visualizador navegar-anterior\\\"\\n[L1119]         type=\\\"button\\\"\\n[L1120]         onclick=\\\"navegarImagem(-1)\\\"\\n[L1121]         aria-label=\\\"Imagem anterior\\\"\\n    \u003e\\n        ‹\\n[L1124]     \u003c/button\u003e\\n\\n[L1126]     \u003cimg id=\\\"imagem-ampliada\\\" src=\\\"\\\" alt=\\\"\\\"\u003e\\n\\n[L1128]     \u003cbutton\\n[L1129]         class=\\\"navegar-visualizador navegar-proximo\\\"\\n[L1130]         type=\\\"button\\\"\\n[L1131]         onclick=\\\"navegarImagem(1)\\\"\\n[L1132]         aria-label=\\\"Próxima imagem\\\"\\n    \u003e\\n        ›\\n[L1135]     \u003c/button\u003e\\n\\n[L1137]     \u003cspan class=\\\"visualizador-contador\\\" id=\\\"contador-imagens\\\"\u003e\\n        1 / 1\\n[L1139]     \u003c/span\u003e\\n\\n[L1141] \u003c/div\u003e\\n\\n[L1143] \u003cscript\u003e\\n\\n[L1145] /* =========================================\\n[L1146]    TROCAR IMAGEM PRINCIPAL\\n[L1147]    ========================================= */\\n\\n[L1149] function trocarFoto(botao, caminho) {\\n\\n[L1151]     const card = botao.closest(\\\".projeto-card\\\");\\n\\n[L1153]     const principal = card.querySelector(\\\".projeto-imagem img\\\");\\n\\n[L1155]     const miniatura = botao.querySelector(\\\"img\\\");\\n\\n[L1157]     principal.src = caminho;\\n\\n[L1159]     principal.alt = miniatura.alt;\\n\\n[L1161]     card.querySelectorAll(\\\".projeto-fotos button\\\")\\n[L1162]         .forEach(function(item) {\\n[L1163]             item.classList.remove(\\\"ativo\\\");\\n        });\\n\\n[L1166]     botao.classList.add(\\\"ativo\\\");\\n}\\n\\n[L1169] /* =========================================\\n[L1170]    VISUALIZADOR\\n[L1171]    ========================================= */\\n\\n[L1173] let imagensAtuais = [];\\n[L1174] let indiceAtual = 0;\\n[L1175] let elementoAnterior = null;\\n\\n[L1177] function abrirImagem(imagemClicada) {\\n\\n[L1179]     const card = imagemClicada.closest(\\\".projeto-card\\\");\\n\\n[L1181]     const miniaturas = Array.from(\\n[L1182]         card.querySelectorAll(\\\".projeto-fotos img\\\")\\n    );\\n\\n[L1185]     if (miniaturas.length \u003e 0) {\\n\\n[L1187]         imagensAtuais = miniaturas.map(function(img) {\\n[L1188]             return {\\n[L1189]                 src: img.src,\\n[L1190]                 alt: img.alt\\n            };\\n        });\\n\\n[L1194]         indiceAtual = imagensAtuais.findIndex(function(item) {\\n[L1195]             return item.src === imagemClicada.src;\\n        });\\n\\n[L1198]         if (indiceAtual \u003c 0) {\\n[L1199]             indiceAtual = 0;\\n        }\\n\\n[L1202]     } else {\\n\\n[L1204]         imagensAtuais = [{\\n[L1205]             src: imagemClicada.src,\\n[L1206]             alt: imagemClicada.alt\\n        }];\\n\\n[L1209]         indiceAtual = 0;\\n    }\\n\\n[L1212]     elementoAnterior = document.activeElement;\\n\\n[L1214]     document.getElementById(\\\"visualizador\\\")\\n[L1215]         .classList.add(\\\"aberto\\\");\\n\\n[L1217]     document.getElementById(\\\"visualizador\\\")\\n[L1218]         .setAttribute(\\\"aria-hidden\\\", \\\"false\\\");\\n\\n[L1220]     document.body.style.overflow = \\\"hidden\\\";\\n\\n[L1222]     atualizarVisualizador();\\n\\n[L1224]     document.querySelector(\\\".fechar-visualizador\\\").focus();\\n}\\n\\n[L1227] function atualizarVisualizador() {\\n\\n[L1229]     const imagem = imagensAtuais[indiceAtual];\\n\\n[L1231]     if (!imagem) {\\n[L1232]         return;\\n    }\\n\\n[L1235]     const ampliada = document.getElementById(\\\"imagem-ampliada\\\");\\n\\n[L1237]     ampliada.src = imagem.src;\\n[L1238]     ampliada.alt = imagem.alt || \\\"Imagem do projeto\\\";\\n\\n[L1240]     document.getElementById(\\\"contador-imagens\\\")\\n[L1241]         .textContent = (indiceAtual + 1) + \\\" / \\\" + imagensAtuais.length;\\n\\n[L1243]     const mostrarNavegacao = imagensAtuais.length \u003e 1;\\n\\n[L1245]     document.querySelector(\\\".navegar-anterior\\\")\\n[L1246]         .style.display = mostrarNavegacao ? \\\"flex\\\" : \\\"none\\\";\\n\\n[L1248]     document.querySelector(\\\".navegar-proximo\\\")\\n[L1249]         .style.display = mostrarNavegacao ? \\\"flex\\\" : \\\"none\\\";\\n}\\n\\n[L1252] function navegarImagem(direcao) {\\n\\n[L1254]     if (imagensAtuais.length === 0) {\\n[L1255]         return;\\n    }\\n\\n[L1258]     indiceAtual = (\\n[L1259]         indiceAtual + direcao + imagensAtuais.length\\n[L1260]     ) % imagensAtuais.length;\\n\\n[L1262]     atualizarVisualizador();\\n}\\n\\n[L1265] function fecharImagem() {\\n\\n[L1267]     const visualizador = document.getElementById(\\\"visualizador\\\");\\n\\n[L1269]     visualizador.classList.remove(\\\"aberto\\\");\\n[L1270]     visualizador.setAttribute(\\\"aria-hidden\\\", \\\"true\\\");\\n\\n[L1272]     document.getElementById(\\\"imagem-ampliada\\\").removeAttribute(\\\"src\\\");\\n\\n[L1274]     document.body.style.overflow = \\\"\\\";\\n\\n[L1276]     if (elementoAnterior \u0026\u0026 typeof elementoAnterior.focus === \\\"function\\\") {\\n[L1277]         elementoAnterior.focus();\\n    }\\n}\\n\\n[L1281] /* FECHAR CLICANDO FORA */\\n\\n[L1283] document.getElementById(\\\"visualizador\\\")\\n[L1284]     .addEventListener(\\\"click\\\", function(evento) {\\n\\n[L1286]         if (evento.target === this) {\\n[L1287]             fecharImagem();\\n        }\\n\\n    });\\n\\n[L1292] /* TECLADO */\\n\\n[L1294] document.addEventListener(\\\"keydown\\\", function(evento) {\\n\\n[L1296]     const aberto = document.getElementById(\\\"visualizador\\\")\\n[L1297]         .classList.contains(\\\"aberto\\\");\\n\\n[L1299]     if (!aberto) {\\n[L1300]         return;\\n    }\\n\\n[L1303]     if (evento.key === \\\"Escape\\\") {\\n[L1304]         fecharImagem();\\n    }\\n\\n[L1307]     if (evento.key === \\\"ArrowRight\\\") {\\n[L1308]         navegarImagem(1);\\n    }\\n\\n[L1311]     if (evento.key === \\\"ArrowLeft\\\") {\\n[L1312]         navegarImagem(-1);\\n    }\\n\\n});\\n\\n[L1317] \u003c/script\u003e\\n\\n[L1319] \u003c/body\u003e\\n[L1320] \u003c/html\u003e\\n\\nUse ref_id \\\"turn7file0\\\" to reference this file. For broad questions or unknown locations, retrieve relevant chunks with `files.search` scoped to this file. Use `files.find` only for exact text, and use `files.read` for a known range or to expand relevant results. Full file size: 1321 file lines.\",{},{\"_456\":638,\"_458\":670,\"_383\":697},1792087483.938608,{\"_451\":693,