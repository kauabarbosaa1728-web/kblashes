            </span><span class="text-codex-syntax-keyword">if</span><span> (</span><span class="text-codex-syntax-variable">evento</span><span class="text-codex-syntax-keyword">.</span><span>key </span><span class="text-codex-syntax-keyword">===</span><span> </span><span class="text-codex-syntax-string">"Enter"</span><span> </span><span class="text-codex-syntax-keyword">||</span><span> </span><span class="text-codex-syntax-variable">evento</span><span class="text-codex-syntax-keyword">.</span><span>key </span><span class="text-codex-syntax-keyword">===</span><span> </span><span class="text-codex-syntax-string">" "</span><span>) {
