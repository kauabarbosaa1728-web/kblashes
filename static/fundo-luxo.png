        </span><span class="text-codex-syntax-variable">imagem</span><span class="text-codex-syntax-keyword">.</span><span>setAttribute(</span><span class="text-codex-syntax-string">"role"</span><span>, </span><span class="text-codex-syntax-string">"button"</span><span>);

