}

</span><span class="text-codex-syntax-variable">document</span><span class="text-codex-syntax-keyword">.</span><span>querySelectorAll(</span><span class="text-codex-syntax-string">".projeto-imagem img"</span><span>)
    </span><span class="text-codex-syntax-keyword">.</span><span>forEach(</span><span class="text-codex-syntax-keyword">function</span><span>(</span><span class="text-codex-syntax-variable">imagem</span><span>) {
